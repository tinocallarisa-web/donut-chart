  "dataViewMappings": [
    {
      "conditions": [
        {
          "category": {
            "max": 1
          },
          "segment": {
            "max": 1
          },
          "facet": {
            "max": 1
          },
          "values": {
            "max": 1
          },
          "compare": {
            "max": 1
          },
          "target": {
            "max": 1
          },
          "annotation": {
            "max": 1
          },
          "tooltips": {
            "max": 5
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "category"
              }
            },
            {
              "for": {
                "in": "facet"
              }
            },
            {
              "for": {
                "in": "segment"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "window": {
              "count": 30000
            }
          }
        },
        "values": {
          "select": [
            {
              "for": {
                "in": "values"
              }
            },
            {
              "for": {
                "in": "compare"
              }
            },
            {
              "for": {
                "in": "target"
              }
            },
            {
              "for": {
                "in": "annotation"
              }
            },
            {
              "for": {
                "in": "tooltips"
              }
            }
          ]
        }
      }
    }
  ],
