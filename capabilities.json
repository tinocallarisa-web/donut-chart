{
  "dataRoles": [
    {
      "displayName": "Category",
      "name": "category",
      "kind": "Grouping",
      "description": "One slice per value of this field."
    },
    {
      "displayName": "Segment (Pro)",
      "name": "segment",
      "kind": "Grouping",
      "description": "Outer ring: each slice split by this field."
    },
    {
      "displayName": "Small multiples (Pro)",
      "name": "facet",
      "kind": "Grouping",
      "description": "One donut per value of this field."
    },
    {
      "displayName": "Values",
      "name": "values",
      "kind": "Measure",
      "description": "The measure the slices share."
    },
    {
      "displayName": "Compare with (Pro)",
      "name": "compare",
      "kind": "Measure",
      "description": "Prior period or plan: change of share and value."
    },
    {
      "displayName": "Target (Pro)",
      "name": "target",
      "kind": "Measure",
      "description": "Target per slice."
    },
    {
      "displayName": "Annotation (Pro)",
      "name": "annotation",
      "kind": "Measure",
      "description": "Text measure shown as a note under its row."
    },
    {
      "displayName": "Tooltips",
      "name": "tooltips",
      "kind": "Measure",
      "description": "Extra measures in the tooltip."
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "category": {
            "max": 1
          },
          "segment": {
            "max": 1
          },
          "facet": {
            "max": 1
          },
          "values": {
            "max": 1
          },
          "compare": {
            "max": 1
          },
          "target": {
            "max": 1
          },
          "annotation": {
            "max": 1
          },
          "tooltips": {
            "max": 5
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "category"
              }
            },
            {
              "for": {
                "in": "facet"
              }
            },
            {
              "for": {
                "in": "segment"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "window": {
              "count": 30000
            }
          }
        },
        "values": {
          "select": [
            {
              "for": {
                "in": "values"
              }
            },
            {
              "for": {
                "in": "compare"
              }
            },
            {
              "for": {
                "in": "target"
              }
            },
            {
              "for": {
                "in": "annotation"
              }
            },
            {
              "for": {
                "in": "tooltips"
              }
            }
          ]
        }
      }
    }
  ],
  "objects": {
    "general": {
      "properties": {
        "formatString": {
          "type": {
            "formatting": {
              "formatString": true
            }
          }
        }
      }
    }
  },
  "privileges": [],
  "tooltips": {
    "supportedTypes": {
      "default": true,
      "canvas": true
    },
    "roles": [
      "tooltips"
    ]
  },
  "supportsHighlight": true,
  "supportsLandingPage": true,
  "supportsKeyboardFocus": true,
  "supportsMultiVisualSelection": true,
  "drilldown": {
    "roles": [
      "category"
    ]
  },
  "sorting": {
    "default": {}
  }
}